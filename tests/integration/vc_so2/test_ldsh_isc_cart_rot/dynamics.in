$system
 ndim = 3
 nstate = 4 3
 multiplicity = 1 3
 istate file istate
 classical_coordinates = cartesian
$surfhop ld-fssh
 velocity nadvec
 tdse_steps 1
 prob_formula sharc
 soc
$dynamics
 tstep = 0.1
 max_time =   100.0000
 orient = 2
$output
 buinterval = 2000
 printerval = 5
 noprint  2,3,4,5,6
 print 7,31
$method
 qlib vibronic_coupling LVC.template
 seed 8987550
$end
