$system
 ndim = 1
 nstate = 4 3
 multiplicity = 1 3
 istate = 2
 effective_spin_states projection
 reference_geometry ref_geom
$surfhop lz
 velocity nadvec
$dynamics
 tstep = 0.1
 max_time =   100.0000
$output
 buinterval = 2000
 printerval = 5
 noprint  2,3,4,5,6
$method
 qlib vibronic_coupling LVC.template
 seed 8987550
 qm_en_error = 1.0e-13
$end
