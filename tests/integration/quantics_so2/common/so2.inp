#######################################################################
###  SO2 LVC model with spin-orbit coupling (13 states)
###  3 trajectories, deterministic initial conditions (wigner = off)
###  No shztrans and no freq0 parameters: the masses of the classical degrees
###  of freedom come from the kinetic energy terms of the operator.
###  ZagHop test (setup_only): Quantics only writes the restart, dvr
###  and oper files; the test runs the trajectory with zaghop.
#######################################################################

RUN-SECTION

name = quantics
propagate
tfinal = 2.0
tout = 0.5
tpsi = 1.0
psi gridpop
title = SO2 TSH
srfhop_zagreb swarm = 3
end-run-section

OPERATOR-SECTION
opname = mr-cisd
end-operator-section


primitive-basis-section
v7     classical
v8     classical
v9     classical
el      el	13
end-primitive-basis-section

SH_ZAGREB-SECTION
setup_only
DYNAMICS.IN
$surfhop ld-fssh
 nadvec  linear
 velocity nadvec
 tdse_steps 10
$method
 seed 11
$dynamics
 tstep = 0.05
$output
 buinterval = 2000
 printerval = 10
 noprint  2,5,7,10,11
 print 8
END-DYNAMICS.IN
END-SH_ZAGREB-SECTION

INIT_WF-SECTION
wigner = off
build
    init_state = 5
    v7    HO    0.00   0.00     1.00     1.00
    v8    HO    0.00   0.00     1.00     1.00
    v9    HO    0.00   0.00     1.00     1.00
end-build
end-init_wf-section

end-input
